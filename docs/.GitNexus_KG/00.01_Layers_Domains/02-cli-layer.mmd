  classDef core fill:#F5A623,stroke:#F5A623,color:#FFFFFF
  classDef storage fill:#9B59B6,stroke:#9B59B6,color:#FFFFFF
  classDef server fill:#50B86C,stroke:#50B86C,color:#FFFFFF
