digraph Storage_Layer {
  rankdir=TB;
  label="GitNexus Storage Layer — Architecture & Internal Dependencies";
  fontsize=16;
  fontname="Consolas";
  compound=true;
  bgcolor="#1E1E2E";
  fontcolor="#CDD6F4";
  edge [fontname="Consolas", fontsize=9];
  node [fontname="Consolas", fontsize=10, style="filled", shape="box"];

  subgraph cluster_storage {
    label="Storage Layer (src/storage/)";
    fontsize=14;
    fontcolor="#9B59B6";
    style="filled";
    color="#9B59B6";
    fillcolor="#2E1E2E";

    // Top-level files
    repo_manager_barrel [label="repo-manager.ts (barrel)", fillcolor="#9B59B6", fontcolor="#FFFFFF", shape="diamond"];
    git [label="git.ts", fillcolor="#9B59B6", fontcolor="#FFFFFF"];

    subgraph cluster_repomanager {
      label="repo-manager/ (9 files)";
      fontsize=12;
      fontcolor="#9B59B6";
      style="filled";
      color="#4A2E4A";
      fillcolor="#2E1E2E";

      // Sub-module files
      paths [label="paths.ts", fillcolor="#B07CC6", fontcolor="#FFFFFF"];
      meta [label="meta.ts", fillcolor="#B07CC6", fontcolor="#FFFFFF"];
      registry [label="registry/index.ts", fillcolor="#B07CC6", fontcolor="#FFFFFF"];
      config_rm [label="config.ts", fillcolor="#B07CC6", fontcolor="#FFFFFF"];
      constants_rm [label="constants.ts", fillcolor="#B07CC6", fontcolor="#FFFFFF", style="dashed"];
      types_rm [label="types.ts", fillcolor="#B07CC6", fontcolor="#FFFFFF", style="dashed"];
      errors [label="errors.ts", fillcolor="#B07CC6", fontcolor="#FFFFFF"];
      gitignore [label="gitignore.ts", fillcolor="#B07CC6", fontcolor="#FFFFFF"];
      finalization [label="finalization.ts", fillcolor="#B07CC6", fontcolor="#FFFFFF"];
    }

    // Barrel re-exports to all submodules
    repo_manager_barrel -> types_rm [label="interface types", color="#9B59B6"];
    repo_manager_barrel -> constants_rm [label="GITNEXUS_DIR, etc", color="#9B59B6"];
    repo_manager_barrel -> errors [label="RegistryNameCollisionError", color="#9B59B6"];
    repo_manager_barrel -> paths [label="canonicalizePath, getStoragePaths", color="#9B59B6"];
    repo_manager_barrel -> registry [label="readRegistry, writeRegistry", color="#9B59B6"];
    repo_manager_barrel -> meta [label="(saveMeta, loadMeta)", color="#9B59B6"];
    repo_manager_barrel -> config_rm [label="(config)", color="#9B59B6"];
    repo_manager_barrel -> gitignore [label="ensureGitNexusIgnored", color="#9B59B6"];
    repo_manager_barrel -> finalization [label="(finalization)", color="#9B59B6"];

    // Internal submodule imports
    repo_manager_barrel -> git [label="getInferredRepoName, resolveRepoIdentityRoot", color="#9B59B6"];

    config_rm -> types_rm [label="CLIConfig", color="#B07CC6"];
    config_rm -> paths [label="getGlobalDir, getGlobalConfigPath", color="#B07CC6"];

    errors -> types_rm [label="RegistryEntry", color="#B07CC6"];

    finalization -> paths [label="getStoragePaths, canonicalizePath", color="#B07CC6"];
    finalization -> errors [label="AnalysisNotFinalizedError", color="#B07CC6"];
    finalization -> registry [label="readRegistry", color="#B07CC6"];

    gitignore -> constants_rm [label="GITNEXUS_DIR, GITNEXUS_EXCLUDE_ENTRY", color="#B07CC6"];
    gitignore -> paths [label="getStoragePath", color="#B07CC6"];

    meta -> types_rm [label="RepoMeta, IndexedRepo", color="#B07CC6"];
    meta -> paths [label="getStoragePaths", color="#B07CC6"];

    paths -> constants_rm [label="GITNEXUS_DIR", color="#B07CC6"];
  }

  // External consumers (sample of key ones)
  subgraph cluster_consumers_st {
    label="Key Storage Consumers";
    fontsize=12;
    fontcolor="#9B59B6";
    style="filled";
    color="#4A2E4A";
    fillcolor="#2E1E2E";

    analyze_cli [label="cli/analyze.ts", fillcolor="#4A90D9", fontcolor="#FFFFFF"];
    run_analyze_s [label="core/run-analyze.ts", fillcolor="#F5A623", fontcolor="#FFFFFF"];
    finalizer_s [label="core/analyze/finalizer.ts", fillcolor="#F5A623", fontcolor="#FFFFFF"];
    state_manager_s [label="mcp/local/helpers/state-manager.ts", fillcolor="#50B86C", fontcolor="#FFFFFF"];
    repo_resolver_s [label="server/middleware/repo-resolver.ts", fillcolor="#50B86C", fontcolor="#FFFFFF"];
    repos_route_s [label="server/routes/repos.ts", fillcolor="#50B86C", fontcolor="#FFFFFF"];
  }

  analyze_cli -> repo_manager_barrel [label="(registerRepo, etc)", color="#4A90D9", style="dashed"];
  analyze_cli -> git [label="getGitRoot, hasGitDir", color="#4A90D9", style="dashed"];
  run_analyze_s -> repo_manager_barrel [label="(repo-manager)", color="#F5A623", style="dashed"];
  run_analyze_s -> git [label="(git storage)", color="#F5A623", style="dashed"];
  finalizer_s -> repo_manager_barrel [label="saveMeta, registerRepo", color="#F5A623", style="dashed"];
  finalizer_s -> git [label="getRemoteUrl, hasGitDir", color="#F5A623", style="dashed"];
  state_manager_s -> repo_manager_barrel [label="listRegisteredRepos", color="#50B86C", style="dashed"];
  repo_resolver_s -> repo_manager_barrel [label="listRegisteredRepos", color="#50B86C", style="dashed"];
  repos_route_s -> repo_manager_barrel [label="listRegisteredRepos, loadMeta", color="#50B86C", style="dashed"];

  // External deps from storage
  repo_manager_barrel -> git [label="getInferredRepoName, resolveRepoIdentityRoot", color="#9B59B6"];
}
