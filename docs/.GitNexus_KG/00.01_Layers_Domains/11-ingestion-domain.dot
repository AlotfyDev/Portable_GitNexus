digraph Ingestion_Domain {
  rankdir=TB;
  label="GitNexus Ingestion Domain — core/ingestion/ (THE BIG ONE)";
  fontsize=16;
  fontname="Consolas";
  compound=true;
  bgcolor="#1E1E2E";
  fontcolor="#CDD6F4";
  edge [fontname="Consolas", fontsize=8, color="#585B70"];
  node [fontname="Consolas", fontsize=9, style="filled", shape="box"];

  subgraph cluster_ingestion {
    label="Ingestion Domain (core/ingestion/)    —    142 files mapped";
    fontsize=14;
    fontcolor="#F5A623";
    style="filled";
    color="#F5A623";
    fillcolor="#2E2E1E";

    // Pipeline orchestrator
    pipeline [label="pipeline.ts", fillcolor="#F5A623", fontcolor="#FFFFFF", shape="diamond"];

    // === SUBGRAPH: Pipeline Phases ===
    subgraph cluster_phases {
      label="pipeline-phases/ (19 files)";
      fontsize=11;
      fontcolor="#D4A017";
      style="filled";
      color="#4A4A2E";
      fillcolor="#2E2E1E";

      phases_index [label="index.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF", style="dashed"];
      types_ph [label="types.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF", style="dashed"];
      scan [label="scan.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      structure [label="structure.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      markdown [label="markdown.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      cobol_ph [label="cobol.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      parse [label="parse.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      parse_impl [label="parse-impl.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      routes_ph [label="routes.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      tools_ph [label="tools.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      orm [label="orm.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      orm_extraction [label="orm-extraction.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      cross_file [label="cross-file.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      cross_file_impl [label="cross-file-impl.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      mro_ph [label="mro.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      communities [label="communities.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      processes_ph [label="processes.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      runner [label="runner.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
      wildcard_synthesis [label="wildcard-synthesis.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF"];
    }

    // Phase edges
    pipeline -> phases_index [label="(imports all phases)", color="#F5A623"];
    phases_index -> scan [label="scanPhase", color="#D4A017"];
    phases_index -> structure [label="structurePhase", color="#D4A017"];
    phases_index -> markdown [label="markdownPhase", color="#D4A017"];
    phases_index -> cobol_ph [label="cobolPhase", color="#D4A017"];
    phases_index -> parse [label="parsePhase", color="#D4A017"];
    phases_index -> routes_ph [label="routesPhase", color="#D4A017"];
    phases_index -> tools_ph [label="toolsPhase", color="#D4A017"];
    phases_index -> orm [label="ormPhase", color="#D4A017"];
    phases_index -> cross_file [label="crossFilePhase", color="#D4A017"];
    phases_index -> mro_ph [label="mroPhase", color="#D4A017"];
    phases_index -> communities [label="communitiesPhase", color="#D4A017"];
    phases_index -> processes_ph [label="processesPhase", color="#D4A017"];
    phases_index -> runner [label="runPipeline", color="#D4A017"];

    scan -> types_ph [label="PipelinePhase, PipelineContext", color="#D4A017"];
    scan -> fs_walker [label="walkRepositoryPaths", color="#D4A017"];

    structure -> types_ph [label="PipelinePhase", color="#D4A017"];
    structure -> structure_proc [label="processStructure", color="#D4A017"];

    markdown -> markdown_proc [label="processMarkdown", color="#D4A017"];
    markdown -> types_ph [label="PipelinePhase", color="#D4A017"];

    cobol_ph -> cobol_proc_barrel [label="processCobol, isCobolFile", color="#D4A017"];
    cobol_ph -> fs_walker [label="readFileContents", color="#D4A017"];

    parse_impl -> binding_acc [label="BindingAccumulator", color="#D4A017"];
    parse_impl -> parsing_proc [label="processParsing", color="#D4A017"];
    parse_impl -> import_proc [label="(import processor)", color="#D4A017"];
    parse_impl -> call_proc [label="(call processor)", color="#D4A017"];
    parse_impl -> heritage_proc [label="(heritage processor)", color="#D4A017"];
    parse_impl -> ast_cache [label="ASTCache, createASTCache", color="#D4A017"];
    parse_impl -> fs_walker [label="readFileContents", color="#D4A017"];
    parse_impl -> worker_pool [label="createWorkerPool", color="#D4A017"];

    cross_file_impl -> call_proc [label="(call processor symbols)", color="#D4A017"];
    cross_file_impl -> ast_cache [label="createASTCache", color="#D4A017"];
    cross_file_impl -> fs_walker [label="readFileContents", color="#D4A017"];

    routes_ph -> nextjs_routes [label="nextjsFileToRouteURL", color="#D4A017"];
    routes_ph -> expo_routes [label="expoFileToRouteURL", color="#D4A017"];
    routes_ph -> php_routes [label="phpFileToRouteURL", color="#D4A017"];
    routes_ph -> resp_shapes [label="(response-shapes)", color="#D4A017"];
    routes_ph -> mid_routes [label="(middleware)", color="#D4A017"];
    routes_ph -> call_proc [label="processNextjsFetchRoutes", color="#D4A017"];

    orm -> orm_extraction [label="ExtractedORMQuery", color="#D4A017"];

    // === SUBGRAPH: Call Processor ===
    subgraph cluster_callproc {
      label="call-processor/ (27 files)";
      fontsize=11;
      fontcolor="#D4A017";
      style="filled";
      color="#4A4A2E";
      fillcolor="#2E2E1E";

      call_proc_barrel [label="call-processor.ts", fillcolor="#E8B84A", fontcolor="#FFFFFF", shape="diamond"];
      call_proc_types [label="types.ts", fillcolor="#C8960E", fontcolor="#FFFFFF", style="dashed"];
      call_proc_constants [label="constants.ts", fillcolor="#C8960E", fontcolor="#FFFFFF", style="dashed"];
      default_dispatch [label="default-dispatch.ts", fillcolor="#C8960E", fontcolor="#FFFFFF"];
      process_calls [label="process-calls.ts", fillcolor="#C8960E", fontcolor="#FFFFFF"];
      process_calls_extracted [label="process-calls-from-extracted.ts", fillcolor="#C8960E", fontcolor="#FFFFFF"];

      subgraph cluster_call_helpers {
        label="helpers/ (21 files)";
        fontsize=10;
        fontcolor="#C8960E";
        style="filled";
        color="#3A3A1E";
        fillcolor="#2E2E1E";

        access_emitter [label="access-emitter.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        assignments [label="assignments.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        callable_candidates [label="callable-candidates.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        constructor_verifier [label="constructor-verifier.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        enclosing_function [label="enclosing-function.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        exported_types [label="exported-types.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        fetch_calls [label="fetch-calls.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        interface_dispatch [label="interface-dispatch.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        member_call_by_file [label="member-call-by-file.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        mixed_chain [label="mixed-chain.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        module_aliased_call [label="module-aliased-call.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        overload_disambiguation [label="overload-disambiguation.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        provider_primary_resolver [label="provider-primary-resolver.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        receiver_resolution [label="receiver-resolution.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        resolve_call_target [label="resolve-call-target.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        resolve_free_call [label="resolve-free-call.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        resolve_member_call [label="resolve-member-call.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        resolve_static_call [label="resolve-static-call.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        routes_call [label="routes.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        seed_cross_file [label="seed-cross-file-receivers.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
        single_candidate [label="single-candidate.ts", fillcolor="#B8860B", fontcolor="#FFFFFF"];
      }
    }

    // Call processor edges
    call_proc_barrel -> exported_types [label="ExportedTypeMap, OverloadHints", color="#D4A017"];
    call_proc_barrel -> seed_cross_file [label="seedCrossFileReceiverTypes", color="#D4A017"];
    call_proc_barrel -> process_calls [label="(process-calls)", color="#D4A017"];
    call_proc_barrel -> resolve_call_target [label="(resolve-call-target)", color="#D4A017"];
    call_proc_barrel -> resolve_member_call [label="(resolve-member-call)", color="#D4A017"];
    call_proc_barrel -> resolve_free_call [label="(resolve-free-call)", color="#D4A017"];
    call_proc_barrel -> resolve_static_call [label="(resolve-static-call)", color="#D4A017"];
    call_proc_barrel -> process_calls_extracted [label="(process-calls-from-extracted)", color="#D4A017"];
    call_proc_barrel -> assignments [label="(assignments)", color="#D4A017"];
    call_proc_barrel -> routes_call [label="(routes)", color="#D4A017"];
    call_proc_barrel -> fetch_calls [label="(fetch-calls)", color="#D4A017"];
    call_proc_barrel -> call_proc_types [label="(types)", color="#D4A017"];

    // === SUBGRAPH: COBOL Processing ===
    subgraph cluster_cobol {
      label="cobol/ + cobol-processor/ + cobol-preprocessor/";
