      cobol_helpers [label="cobol-processor/helpers/ (3 files)", fillcolor="#B8860B", fontcolor="#FFFFFF"];
    }

    // === SUBGRAPH: Scope Extraction ===
    subgraph cluster_scope {
      label="scope-extractor/ (10 files)";
      fontsize=11;
      fontcolor="#D4A017";
      style="filled";
      color="#4A4A2E";
