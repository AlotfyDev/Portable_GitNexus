      cobol_const [label="cobol-processor/constants.ts", fillcolor="#C8960E", fontcolor="#FFFFFF", style="dashed"];
      cobol_detectors [label="cobol-processor/detectors.ts", fillcolor="#C8960E", fontcolor="#FFFFFF"];
