    style MCP fill:#1E2E2E,stroke:#50B86C,color:#CDD6F4

    server("server.ts"):::entry
    tools("tools.ts"):::barrel
    resources("resources.ts"):::util
    staleness("staleness.ts"):::util
    stdio_context("stdio-context.ts"):::util
    stdio_capture("stdio-capture.ts"):::util
    compatible_stdio("compatible-stdio-transport.ts"):::util
    embedder_mcp("core/embedder.ts"):::util
    lbug_adapter_mcp("core/lbug-adapter.ts"):::util

