  search -.->|EMBEDDING_TABLE_NAME| lbug_schema_mcp("core/lbug/schema.ts"):::core
  search -.->|platform capabilities| runtime_capabilities_mcp("core/platform/capabilities.ts"):::core
  search -.->|PhaseTimer| phase_timer_mcp("core/search/phase-timer.ts"):::core
  search -.->|logger| logger_mcp
  state_manager -.->|executeParameterized| pool_adapter_mcp
  state_manager -.->|listRegisteredRepos, cleanupOldKuzuFiles| repo_manager_mcp("storage/repo-manager.ts"):::storage
  state_manager -.->|checkStalenessAsync| git_staleness_mcp("core/git-staleness.ts"):::core
  state_manager -.->|logger| logger_mcp
  state_manager -.->|GroupService, GroupToolPort| group_service_mcp("core/group/service.ts"):::core
  symbol_resolution -.->|executeParameterized| pool_adapter_mcp

