  // ═══════════════════════════════════════════════════════════════════
  // PIPELINE FLOW — main processing chain
  // ═══════════════════════════════════════════════════════════════════

  // Pipeline phase ordering (horizontal flow)
  // call-processor → parse-worker → cobol-processor → parsing-processor
  // → scope-extractor → type-extractors → type-env → model

  // Root pipeline orchestrates everything
  root_pipeline -> pp_scan    [label="initPipeline", weight=100, penwidth=2.5, color="#2ECC71"];

  // Pipeline phase chain (actual pipeline order from pipeline-phases/index.ts)
  pp_scan      -> pp_structure    [label="→ phase 2", weight=100, penwidth=2.0, color="#2ECC71"];
  pp_structure -> pp_markdown     [label="→ phase 3", weight=100, penwidth=2.0, color="#2ECC71"];
  pp_markdown  -> pp_cobol        [label="→ phase 4", weight=100, penwidth=2.0, color="#2ECC71"];
  pp_cobol     -> pp_parse        [label="→ phase 5", weight=100, penwidth=2.0, color="#2ECC71"];
  pp_parse     -> pp_parse_impl   [label="delegates to", weight=80, color="#2ECC71"];
  pp_parse     -> pp_routes       [label="→ phase 6", weight=100, penwidth=2.0, color="#2ECC71"];
  pp_routes    -> pp_tools        [label="→ phase 7", weight=100, penwidth=2.0, color="#2ECC71"];
  pp_tools     -> pp_orm          [label="→ phase 8", weight=100, penwidth=2.0, color="#2ECC71"];
  pp_orm       -> pp_cross_file   [label="→ phase 9", weight=100, penwidth=2.0, color="#2ECC71"];
  pp_cross_file-> sr_pipeline     [label="→ phase 10 (scope-res)", weight=100, penwidth=2.0, color="#2ECC71"];
  sr_pipeline  -> pp_mro          [label="→ phase 11", weight=100, penwidth=2.0, color="#2ECC71"];
  pp_mro       -> pp_communities  [label="→ phase 12", weight=100, penwidth=2.0, color="#2ECC71"];
  pp_communities-> pp_processes   [label="→ phase 13", weight=100, penwidth=2.0, color="#2ECC71"];

  // Internal processing chain (the user-specified ordering)
  root_call_proc -> cp_process_calls [label="delegates to", style=dashed, color="#666666"];

  // call-processor uses call-types
  cp_process_calls -> root_call_types [label="processCalls", dir=back, style=dashed, color="#999999"];

  // parse phase invokes workers
  pp_parse_impl -> wk_main        [label="spawnParseWorkers", penwidth=2.0, color="#1ABC9C"];

  // Call processor feeds into scope extraction
  cp_process_extracted -> se_extract [label="scope-extract (indirect)", style=dashed, color="#999999"];

  // Scope extraction feeds into type environment
  se_extract -> te_build [label="buildTypeEnvironment", style=dashed, color="#999999"];

  // Type environment uses model
  te_build -> mdl_semantic [label="creates/uses", style=dashed, color="#999999"];

  // type-extractors used by parsing + languages
  root_parsing_proc -> pp_parse [label="barrel re-export", style=dashed, color="#AAAAAA"];

  // Workers use scope-extractor
  wk_file_group -> se_extract [label="extractScopes", penwidth=1.5, color="#2980B9"];

  // Import resolvers used by import-processor
  root_import_proc -> ir_resolver_factory [label="resolveImports", penwidth=1.5, color="#2980B9"];

  // Pipeline scope-res phase uses scope-resolution
  pp_cross_file -> sr_pipeline [label="triggers", style=dashed, color="#999999"];

  // Languages barrel → language-provider interface
  lang_index -> root_lang_prov [label="implements", dir=back, style=dashed, color="#999999"];

  // Tree-sitter queries → parsing
  tsq_index -> pp_parse [label="querySource", style=dashed, color="#999999"];

  // type-extractors language-specific files → languages
  te_ts -> lang_ts [label="typeExtractor", style=dashed, color="#AAAAAA"];
  te_ccpp -> lang_ccpp [label="typeExtractor", style=dashed, color="#AAAAAA"];
  te_py -> lang_py [label="typeExtractor", style=dashed, color="#AAAAAA"];

  // Model used by type-env
  mdl_type_reg -> te_build [label="type registration", style=dashed, color="#999999", dir=back];
  mdl_method_reg -> te_build [label="method lookup", style=dashed, color="#999999", dir=back];

  // Heritage processor → model heritage-map
  root_heritage_proc -> mdl_heritage [label="buildHeritageMap", penwidth=1.5, color="#7F8C8D"];

  // MRO processor → model resolve
  root_mro_proc -> mdl_resolve [label="method resolution", penwidth=1.5, color="#7F8C8D"];

  // Route extractors → pipeline routes phase
  pp_routes -> re_middleware [label="extractRoutes", style=dashed, color="#999999"];

  // Pipeline cobol phase → cobol-processor
  pp_cobol -> cbp_main [label="processCOBOL", penwidth=1.5, color="#D35400"];

  // Parse-worker helpers → specific processing
  wk_route_extr -> pp_routes [label="route detection", style=dashed, color="#999999"];

  // Named-bindings used by import-resolvers
  nb_types -> ir_types [label="share types", style=dashed, color="#999999"];

  // ─── Legend ─────────────────────────────────────────────────────────
  subgraph cluster_legend {
    label="Legend";
    fontsize=11; fontweight=bold;
    style=filled; fillcolor="#FFFFFF"; color="#DDDDDD";
    pencolor="#AAAAAA";
    node [shape=none, fillcolor=transparent, color=transparent,
          fontname="Segoe UI", fontsize=9, margin="0,0"];

    legend_label1 [label=<
      <table border="0" cellborder="0" cellspacing="3">
        <tr><td><font point-size="10"><b>Pipeline Phase Flow</b></font></td></tr>
        <tr><td><font color="#2ECC71">━━▶</font> sequential phase edge</td></tr>
        <tr><td><font color="#2980B9">━━▶</font> data dependency</td></tr>
        <tr><td><font color="#999999">- - ▶</font> indirect / re-export</td></tr>
        <tr><td><font color="#666666">- - ▶</font> barrel re-export</td></tr>
        <tr><td><hr/></td></tr>
        <tr><td><font point-size="10"><b>Colors by Sub-Directory</b></font></td></tr>
        <tr><td><table border="0" cellspacing="2">
          <tr><td bgcolor="#E8F8F5" width="12" height="12"/></td><td>call-processor (mint)</td></tr>
          <tr><td bgcolor="#FDF2E9" width="12" height="12"/></td><td>cobol* (warm)</td></tr>
          <tr><td bgcolor="#F5EEF8" width="12" height="12"/></td><td>parsing-processor, call-extr (lavender)</td></tr>
          <tr><td bgcolor="#EBF5FB" width="12" height="12"/></td><td>scope-extractor, class-extr (sky)</td></tr>
          <tr><td bgcolor="#FEF9E7" width="12" height="12"/></td><td>type-env (yellow)</td></tr>
          <tr><td bgcolor="#EAFAF1" width="12" height="12"/></td><td>type-extractors, field-extr (green)</td></tr>
          <tr><td bgcolor="#F5F5F5" width="12" height="12"/></td><td>tree-sitter-queries (gray)</td></tr>
          <tr><td bgcolor="#FADBD8" width="12" height="12"/></td><td>languages (rose)</td></tr>
          <tr><td bgcolor="#D5F5E3" width="12" height="12"/></td><td>pipeline-phases, workers (leaf)</td></tr>
          <tr><td bgcolor="#E8E8E8" width="12" height="12"/></td><td>utils, model (light gray)</td></tr>
        </table></td></tr>
      </table>
    >];
  }
}
